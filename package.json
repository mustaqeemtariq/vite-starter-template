		"vite-plugin-svgr": "^5.2.0"
	},
	"devDependencies": {
		"@types/node": "^22.20.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"tailwindcss": "^4.3.3",
