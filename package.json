    "@vitejs/plugin-react": "^5.1.3",
    "axios": "^1.13.4",
    "clsx": "^2.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "vite-plugin-svgr": "^4.5.0"
  },
  "devDependencies": {
