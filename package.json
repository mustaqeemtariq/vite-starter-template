{
  "name": "vite-react-ts",
  "version": "0.0.0",
  "private": true,
  "description": "React Typescript Starter Template with Vite",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mustaqeemtariq/vite-starter-template"
  },
  "keywords": [
    "vite",
    "react",
    "starter",
    "template"
  ],
  "author": "Mustaqeem Tariq <mustaqeemtariq66@gmail.com>",
  "homepage": "https://github.com/mustaqeemtariq/vite-starter-template",
  "scripts": {
    "start": "PORT=3000 NODE_ENV=development vite",
